{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-skill-pretool-telemetry.js'));\"",
        "powershell": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-skill-pretool-telemetry.js'));\"",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-skill-posttool-validation.js'));\"",
        "powershell": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-skill-posttool-validation.js'));\"",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-user-prompt-telemetry.js'));\"",
        "powershell": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(!root){process.exit(0);} require(path.resolve(root,'hooks','run-user-prompt-telemetry.js'));\"",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
